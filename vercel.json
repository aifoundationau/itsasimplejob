{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/service-provider",
      "destination": "/service-provider.html"
    },
    {
      "source": "/customer-admin",
      "destination": "/customer-admin.html"
    },
    {
      "source": "/customer",
      "destination": "/customer.html"
    },
    {
      "source": "/provider",
      "destination": "/provider.html"
    },
    {
      "source": "/franchise",
      "destination": "/franchise.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
