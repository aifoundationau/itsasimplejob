# ==============================================================================
# It's A Simple Job - Environment Configuration Example Template
# Duplicate this file as .env and populate with your production keys.
# ==============================================================================

# Application Settings
NODE_ENV=development
PORT=3000
APP_NAME="It's A Simple Job"
APP_URL=http://localhost:3000

# Google Maps Platform (Places, Geometry, Geocoding & Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Default Regional Settings
DEFAULT_REGION=AU
DEFAULT_STATE=QLD
DEFAULT_LAT=-28.0280
DEFAULT_LNG=153.4312
DEFAULT_SUBURB="Broadbeach QLD 4218"

# Optional: Google Gemini AI API Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
