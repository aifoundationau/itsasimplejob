# ==============================================================================
# It's A Simple Job - Environment Configuration Template
# Copy this file to .env and fill in your active API keys
# ==============================================================================

# Application Settings
NODE_ENV=development
PORT=3000
APP_NAME="It's A Simple Job"
APP_URL=http://localhost:3000

# Google Maps Platform (Places, Geometry, Geocoding & Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Default Regional Settings
DEFAULT_REGION=AU
DEFAULT_STATE=QLD
DEFAULT_LAT=-28.0280
DEFAULT_LNG=153.4312
DEFAULT_SUBURB="Broadbeach QLD 4218"

# Google Gemini AI API Configuration (Agent Platform API)
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=your_gemini_project_id_here
GEMINI_MODEL=gemini-3.8-flash

# Stripe Payment Gateway Configuration
STRIPE_ACCOUNT_ID=acct_your_stripe_account_id
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ImgBB Image Hosting & Album Configuration
IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
IMGBB_ALBUM_URL=https://ibb.co/album/your_album_id
IMGBB_ALBUM_ID=your_album_id

# Firebase Cloud Firestore & Authentication
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
# Dedicated Firestore database for this app (named database in the project)
FIREBASE_DATABASE_ID=itsasimplejob

# ==============================================================================
# SERVER-ONLY (never sent to the browser; set these in Vercel > Settings > Environment Variables)
# ==============================================================================

# Firebase Admin service account JSON (raw JSON on one line, or base64-encoded).
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated Google account emails allowed into the superadmin panel
SUPERADMIN_EMAILS=you@example.com

# Currency: everything is priced and invoiced in AUD (1 token = A$1 by default; the superadmin sets the
# token price and every token amount in the price list). Visitors outside Australia and New Zealand see a
# USD conversion at a daily live rate; this AUD -> USD rate is used only if both FX feeds are down.
FX_FALLBACK_AUD_USD=0.70

# Local dev only: country to assume when there is no Vercel IP-country header
# (AU or NZ shows AUD prices; any other country shows the USD conversion)
DEV_COUNTRY=AU
