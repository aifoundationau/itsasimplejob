# ==============================================================================
# It's A Simple Job - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Settings
NODE_ENV=development
PORT=3000
APP_NAME="It's A Simple Job"
APP_URL=http://localhost:3000

# Google Maps Platform (Places, Geometry, Geocoding & Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Default Regional Settings
DEFAULT_REGION=AU
DEFAULT_STATE=QLD
DEFAULT_LAT=-28.0280
DEFAULT_LNG=153.4312
DEFAULT_SUBURB="Broadbeach QLD 4218"

# Google Gemini AI API Configuration (Agent Platform API)
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=gen-lang-client-0551298781
GEMINI_MODEL=gemini-3.8-flash

# Stripe Payment Gateway Configuration
STRIPE_ACCOUNT_ID=your_stripe_account_id_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ImgBB Image Hosting & Album Configuration
IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
IMGBB_ALBUM_URL=https://ibb.co/album/k4vjCb
IMGBB_ALBUM_ID=k4vjCb

# Firebase Cloud Firestore & Authentication
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=ai-foundation-firebase.firebaseapp.com
FIREBASE_PROJECT_ID=ai-foundation-firebase
FIREBASE_STORAGE_BUCKET=ai-foundation-firebase.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
